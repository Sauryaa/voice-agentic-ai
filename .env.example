ENV=development
PORT=8080
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=*
STT_LANGUAGE_CODE=en-US
SILENCE_TIMEOUT_SECONDS=1.5
MAX_RECORDING_SECONDS=900
QUESTION_BANK_PATH=data/headache_questions-ForVoicePrototyping.xlsx
MAX_CLARIFICATIONS_PER_QUESTION=2
MINIMUM_ANSWER_WORD_COUNT=5
GEMINI_TEMPERATURE=0.1
GEMINI_QUESTION_TEMPERATURE=0.3
INCLUDE_ACKNOWLEDGMENT_TURNS=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_EXPECTED_ACTION=start_interview
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_VERIFY_TIMEOUT_SECONDS=5.0
